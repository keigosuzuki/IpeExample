<ipestyle name="font_plexsans">

<preamble>

\usepackage{iftex}

\ifluatex
    \usepackage[deluxe,expert,haranoaji]{luatexja-preset}
    \usepackage{notomath}
    \setsansfont{IBMPlexSans-Text.otf}[
        BoldFont=IBMPlexSans-SemiBold.otf,
        ItalicFont=IBMPlexSans-TextItalic.otf,
        BoldItalicFont=IBMPlexSans-SemiBoldItalic.otf,
    ]
    \setsansjfont{IBM Plex Sans JP Text}[
        BoldFont=IBM Plex Sans JP SemiBold,
    ]
    \renewcommand{\familydefault}{\sfdefault}
    \renewcommand{\kanjifamilydefault}{\gtdefault}

\else\ifpdftex
    \usepackage{amsmath}
    \usepackage{newtxtext}
    \usepackage[whole]{bxcjkjatype}
    \renewcommand\familydefault{\sfdefault}

\else
\fi\fi

</preamble>

</ipestyle>
