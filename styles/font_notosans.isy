<ipestyle name="font_notosans">

<preamble>

\usepackage{iftex}

\ifluatex
    \usepackage[deluxe,expert,haranoaji]{luatexja-preset}
    \usepackage{notomath}
    \setsansfont{Noto Sans Regular}[
        BoldFont=Noto Sans Bold,
        ItalicFont=Noto Sans Italic,
        BoldItalicFont=Noto Sans Bold Italic,
    ]
    \setsansjfont{Source Han Sans JP Regular}[
        BoldFont=Source Han Sans JP Medium,
    ]
    \renewcommand{\familydefault}{\sfdefault}
    \renewcommand{\kanjifamilydefault}{\gtdefault}

\else\ifpdftex
    \usepackage{amsmath}
    \usepackage{newtxtext}
    \usepackage[whole]{bxcjkjatype}
    \usepackage{notomath}
    \renewcommand\familydefault{\sfdefault}

\else
\fi\fi

</preamble>

</ipestyle>
