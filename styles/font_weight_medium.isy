<!-- font_notosans.isy より後に読み込むこと。和文欧文とも Sans を Medium ウェイトに上書きする。 -->
<ipestyle name="font_weight_medium">

<preamble>

\ifluatex
    \setsansfont{Noto Sans Medium}[
        BoldFont=Noto Sans Bold,
        ItalicFont=Noto Sans Italic,
        BoldItalicFont=Noto Sans Bold Italic,
    ]
\fi

</preamble>

</ipestyle>
